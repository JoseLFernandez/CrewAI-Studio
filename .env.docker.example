# CrewAI Studio Environment Configuration
# Copy this file to .env and update with your values

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=crewaiuser
POSTGRES_PASSWORD=secret123
POSTGRES_DB=crewai
DB_URL=postgresql://crewaiuser:secret123@db:5432/crewai

# ===== PORT CONFIGURATION =====
WEB_PORT=8501          # Streamlit app port
API_PORT=8000          # FastAPI backend port  
FRONTEND_PORT=3001     # React frontend port

# ===== FRONTEND CONFIGURATION =====
NEXT_PUBLIC_API_URL=http://localhost:8000

# ===== LLM API KEYS =====
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=
OPENAI_PROXY_MODELS=

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LM Studio (local)
LMSTUDIO_API_BASE=http://localhost:1234/v1

# Ollama (local)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODELS=llama3,codellama

# ===== TOOLS & SERVICES =====
# Search
SERPER_API_KEY=your_serper_api_key_here

# Observability
AGENTOPS_API_KEY=your_agentops_api_key_here
AGENTOPS_ENABLED=False

# ===== DEVELOPMENT SETTINGS =====
DEBUG=false
NODE_ENV=production
